# ─── Core ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | production
DEBUG=False
SECRET_KEY=change-me-use-50-random-chars-in-production

ALLOWED_HOSTS=localhost,backend,127.0.0.1

# ─── Database ─────────────────────────────────────────────────────────────────
# Use DATABASE_URL (Docker) or individual params (local dev):
DATABASE_URL=postgresql://repair_crm:repair_crm@localhost:5432/repair_crm

# Individual params (used if DATABASE_URL is not set):
POSTGRES_DB=repair_crm
POSTGRES_USER=repair_crm
POSTGRES_PASSWORD=repair_crm
DB_HOST=localhost
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=Europe/Moscow

# ─── CORS / Security ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ─── Sentry (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=False

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@repair-crm.local

# ─── Communications ───────────────────────────────────────────────────────────
COMMUNICATIONS_ENABLE_EMAIL=True
COMMUNICATIONS_ENABLE_SMS=False

# Twilio (optional, only if SMS enabled):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Payments (YooKassa) ──────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_MOCK=True
YOOKASSA_CAPTURE=True

# ─── Frontend / Public URLs ───────────────────────────────────────────────────
FRONTEND_URL=http://127.0.0.1:4200
BACKEND_PUBLIC_URL=http://127.0.0.1:8030

# ─── Client Portal Integration ────────────────────────────────────────────────
PORTAL_DEFAULT_SHOP_CODE=

# ─── RepireCRM Admin Agent ────────────────────────────────────────────────────
ADMIN_SERVICE_URL=
ADMIN_SERVICE_AGENT_TOKEN=
ADMIN_SERVICE_HEARTBEAT_ENABLED=False
ADMIN_SERVICE_HEARTBEAT_INTERVAL_SECONDS=300
ADMIN_SERVICE_TIMEOUT_SECONDS=5
ADMIN_SERVICE_ENFORCEMENT_ENABLED=False
ADMIN_SERVICE_ENFORCEMENT_REQUIRE_SYNC=False
ADMIN_SERVICE_ENFORCEMENT_STALE_GRACE_HOURS=72
ADMIN_SERVICE_ENFORCEMENT_ALLOW_SUPERUSER_BYPASS=True
APP_VERSION=
